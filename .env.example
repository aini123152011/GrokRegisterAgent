# Grok Register Agent 环境变量示例
# 复制为 .env 后配合根目录 docker-compose.yml 使用：
#   cp .env.example .env
#   docker compose up -d --pull always --remove-orphans

# Web UI 暴露到宿主机的端口
WEB_PORT=6657

# 注册轮数默认值
RUN_COUNT=10

# 邮件后端
# MAIL_PROVIDER：cloudflare / duckmail / yyds / gptmail / remail
#
# Cloudflare Temp Email:
#   MAIL_API_BASE：Worker/API 根地址
#   MAIL_ADMIN_AUTH：网站 admin 密码，用于 x-admin-auth
#   MAIL_DOMAIN：已配置并可收信的域名
#
# Remail:
#   MAIL_API_BASE=https://remail.aishop6.com
#   MAIL_ADMIN_AUTH=rk-...
#   REMAIL_PROJECT_ID / REMAIL_PRODUCT_ID 可留空后在 Web 设置页下拉选择
#   REMAIL_EMAIL_SUFFIXES 留空表示按 Remail 默认；有值时从这些后缀中随机选择
MAIL_PROVIDER=
MAIL_API_BASE=
MAIL_ADMIN_AUTH=
MAIL_DOMAIN=
REMAIL_PROJECT_ID=
REMAIL_PRODUCT_ID=
REMAIL_EMAIL_SUFFIXES=

# 可选代理
HTTP_PROXY=
BROWSER_PROXY=

# HTTPS 反向代理访问时设为 1；直接 http://IP:6657 部署请留空
COOKIE_SECURE=

# Web 鉴权默认账号密码会打印在 docker logs 中；首次登录后 WebUI 会强制修改

# 可选：本地 Turnstile Solver 子容器（默认不拉取）
# 启动：docker compose --profile solver up -d
# 或设置：COMPOSE_PROFILES=solver
TURNSTILE_SOLVER_ENABLED=0
TURNSTILE_SOLVER_URL=http://turnstile-solver:5072
TURNSTILE_SOLVER_THREADS=2
TURNSTILE_SOLVER_BROWSER=chromium
# TURNSTILE_SOLVER_DEBUG=0
# TURNSTILE_SOLVER_PROXY=0

# 可选第三方打码
YESCAPTCHA_KEY=
