# Local source build
#   cd docker
#   cp .env.example .env
#   docker compose up -d --build
# Add --profile solver when the optional local solver is needed.

WEB_PORT=6657
RUN_COUNT=10

# Durable OAuth authorization queue (recommended in Docker)
AUTH_QUEUE_DAEMON=1
AUTH_QUEUE_WORKERS=1
AUTH_QUEUE_MAX_ATTEMPTS=4
OAUTH_PREFLIGHT_CACHE_SEC=45
XAI_OIDC_ISSUER=https://auth.x.ai

# Optional local Turnstile solver
# COMPOSE_PROFILES=solver
TURNSTILE_SOLVER_ENABLED=0
TURNSTILE_SOLVER_URL=http://turnstile-solver:5072
TURNSTILE_SOLVER_HOST_PORT=5072
TURNSTILE_SOLVER_THREADS=2
TURNSTILE_SOLVER_BROWSER=chromium
TURNSTILE_SOLVER_DEBUG=0
TURNSTILE_SOLVER_PROXY=1
TURNSTILE_API_KEY=
TURNSTILE_ADMIN_KEY=
TURNSTILE_ALLOWED_HOSTS=accounts.x.ai
TURNSTILE_QUEUE_SIZE=16
TURNSTILE_TASK_TIMEOUT=90
TURNSTILE_BROWSER_AUTO_FETCH=1

# Mail provider
MAIL_PROVIDER=
MAIL_API_BASE=
MAIL_ADMIN_AUTH=
MAIL_DOMAIN=
REMAIL_PROJECT_ID=
REMAIL_PRODUCT_ID=
REMAIL_EMAIL_SUFFIXES=

# Optional registration proxy
HTTP_PROXY=
BROWSER_PROXY=

# Set to 1 only when the UI is served behind HTTPS.
COOKIE_SECURE=

# Optional fallback provider
YESCAPTCHA_KEY=
