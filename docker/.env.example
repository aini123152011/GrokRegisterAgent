# 本地源码构建环境变量示例
# 在 docker/ 目录执行：
#   cp .env.example .env
#   docker compose up -d --build

WEB_PORT=6657
RUN_COUNT=10

# 邮件后端
# MAIL_PROVIDER：cloudflare / duckmail / yyds / gptmail / remail
#
# Cloudflare Temp Email:
#   MAIL_API_BASE：Worker/API 根地址，例如 https://mail-api.example.com
#   MAIL_ADMIN_AUTH：网站 admin 密码，用于 x-admin-auth
#   MAIL_DOMAIN：已配置并可收信的域名，例如 example.com
#
# Remail:
#   MAIL_API_BASE=https://remail.aishop6.com
#   MAIL_ADMIN_AUTH=rk-...
#   REMAIL_PROJECT_ID / REMAIL_PRODUCT_ID 可留空后在 Web 设置页下拉选择
#   REMAIL_EMAIL_SUFFIXES 留空表示按 Remail 默认；有值时从这些后缀中随机选择
MAIL_PROVIDER=
MAIL_API_BASE=
MAIL_ADMIN_AUTH=
MAIL_DOMAIN=
REMAIL_PROJECT_ID=
REMAIL_PRODUCT_ID=
REMAIL_EMAIL_SUFFIXES=

# 可选代理
HTTP_PROXY=
BROWSER_PROXY=

# HTTPS 反向代理访问时设为 1；直接 http://IP:6657 部署请留空
COOKIE_SECURE=
